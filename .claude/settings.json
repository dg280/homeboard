{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/didier-brain/bin/brain doctor --quiet"
          },
          {
            "type": "command",
            "command": "$HOME/didier-brain/bin/brain tickets --quiet"
          },
          {
            "type": "command",
            "command": "python3 $HOME/didier-brain/bin/brain-hooks.py session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/didier-brain/bin/brain-hooks.py pre-commit",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/didier-brain/bin/brain-hooks.py post-write",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/didier-brain/bin/brain-hooks.py stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
